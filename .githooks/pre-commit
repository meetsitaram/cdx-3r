#!/bin/sh
# 1. Model checks (cad/fusion/checks.py): whenever model code or prints are staged, the fastener and collision reports
#    in prints/*/ must pass and be stamped with the current model sources. They run in Fusion on the assembly
#    (checks.run_all, also the first step of every export); this hook only verifies them.
model=$(git diff --cached --name-only --diff-filter=AMD -- 'cad/fusion/*.py' 'cad/fusion/*.json' 'prints/*')
if [ -n "$model" ]; then
  python cad/fusion/checks.py --verify || { echo "pre-commit: model checks missing, failing or stale"; exit 1; }
fi
# Names used but defined nowhere: Fusion's module reload keeps deleted globals alive, so such code passes in Fusion
# and breaks in a fresh session (gripper3.MU_SLIDE, 25 Oct).
py=$(git diff --cached --name-only --diff-filter=AM -- 'cad/fusion/*.py' 'cad/sim/*.py')
if [ -n "$py" ]; then
  python cad/fusion/undefined_names.py $py || { echo "pre-commit: undefined names (see above)"; exit 1; }
fi
# Markdown tables must render: the separator row needs as many columns as the header (tools/md_tables.py --fix).
md=$(git diff --cached --name-only --diff-filter=AM -- '*.md')
if [ -n "$md" ]; then
  python tools/md_tables.py $md || { echo "pre-commit: broken markdown table (run python tools/md_tables.py --fix)"; exit 1; }
fi
# Bug notes (docs/bugs): named after what went wrong, no numbers; every note listed in the README table.
for f in docs/bugs/*.md; do
  b=$(basename "$f"); [ "$b" = README.md ] && continue
  case "$b" in [0-9]*) echo "pre-commit: $f: no numbers in bug file names (name it after what went wrong)"; exit 1;; esac
  grep -q "($b)" docs/bugs/README.md || { echo "pre-commit: $f is not listed in docs/bugs/README.md"; exit 1; }
done
# 2. Every print STL is committed pre-rotated into its print orientation (cad/fusion/orient_stls.py), so the slicer's
#    auto-orient is never needed. Any STL staged under prints/ that was not oriented yet is oriented here and re-staged.
files=$(git diff --cached --name-only --diff-filter=AM -- 'prints/*.stl' 'prints/**/*.stl')
[ -z "$files" ] && exit 0
# every staged STL must match the model it was exported from (model_volumes.json, written by export_prints.py)
for d in $(for f in $files; do dirname "$f"; done | sort -u); do
  out=$(python -c "import sys; sys.path.insert(0, 'cad/fusion'); import orient_stls as o; o.check_current('$d')")
  echo "pre-commit: $d: $out"
  case "$out" in STALE*) echo "pre-commit: re-export the stale parts first"; exit 1;; esac
  python cad/fusion/print_validate.py "$d" || { echo "pre-commit: printability check failed in $d (thin wall or extra shell)"; exit 1; }
done
dirs=$(for f in $files; do head -c 21 "$f" | grep -q "oriented for printing" || dirname "$f"; done | sort -u)
[ -z "$dirs" ] && exit 0
for d in $dirs; do
  echo "pre-commit: orienting STLs in $d"
  python cad/fusion/orient_stls.py "$d" || { echo "pre-commit: orient_stls failed in $d"; exit 1; }
  git add "$d"
done
